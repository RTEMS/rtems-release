#
# RTEMS Release Site Information
#
. ${release_top}/rtems-release-path

#
# Calculate @R_SP@ column padding and assemble README.md (and plain-text README.txt)
#
rep_len=$(echo "@RELEASE@@R_SP@" | wc -c)
rev_len=$(echo "${release}" | wc -c)
sp_len=$(expr ${rep_len} - ${rev_len} - 7)
r_sp=$(head -c ${sp_len} < /dev/zero | tr '\0' ' ')

md_files="${rtems_readme} ${rtems_readme_release_notes}"
for md in ${md_files}; do
 if [ -f "${md}" ]; then
  cat "${md}"
  echo ""
  echo ""
 else
  ver=${md#notes/rtems-notes-}
  ver=${ver%.md}
  echo "## RTEMS ${ver} Release Notes"
  echo ""
  echo "See [RTEMS ${release} Release Notes](rtems-${release}-release-notes)."
  echo ""
 fi
done | \
 sed -e "s|@RELEASE_URL@|${escaped_release_path}|g" \
     -e "s|@RELEASE@|${release}|g" \
     -e "s|@VERSION@|${version}|g" \
     -e "s|@REVISION@|${revision}|g" \
     -e "s|@RTEMS_RELEASE_NOTES@|${release_notes}|g" \
     -e "s|@R_SP@|${r_sp}|g" \
     -e "s|@DATE@|${now}|g" > "${release}/contrib/README-base.md"

# Assemble full README.md (including ARCH-BSP.md)
{
  cat ${release}/contrib/README-base.md
  echo "## Architectures and BSPs"
  echo ""
  cat ARCH-BSP.md
} > ${release}/contrib/README.md

title="RTEMS ${version} Embedded Realtime Operating System"

# Generate clean, formatted plain-text README.txt (without Pandoc)
${release_top}/rtems-release-gen-readme.py \
  --title "${title}" \
  --markdown "${release}/contrib/README.md" \
  --output "${release}/README.txt"

# Generate Svelte Single-File Static Release Coverpage (${release}/index.html)
site_template="${release_top}/rtems-release-site"
site_build_dir="${release}/contrib/site-build"

${release_top}/rtems-release-gen-coverpage.py \
  --title "${title}" \
  --release "${release}" \
  --version "${version}" \
  --revision "${revision}" \
  --release-url "${release_path}" \
  --release-notes "${release_notes}" \
  --date "${now}" \
  --release-top "${release_top}" \
  --site-template "${site_template}" \
  --build-dir "${site_build_dir}" \
  --readme-base "${release}/contrib/README-base.md" \
  --arch-bsp "ARCH-BSP.md" \
  --output "${release}/index.html"

